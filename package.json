{
  "name": "mesa-it",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/main.js",
    "dev:full": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev\"",
    "start:server": "node server/main.js",
    "start": "node server/main.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test server/*.test.js",
    "test:server:coverage": "c8 --config .c8rc.json node --test server/*.test.js",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.574.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.1.18",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.2",
    "c8": "12.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.2",
    "wrangler": "^4.114.0"
  }
}
